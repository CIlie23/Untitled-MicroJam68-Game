[connection signal="pressed" from="Picker/Margin/Layout/Buttons/SelectAll" to="." method="_on_select_all_pressed"]
[connection signal="pressed" from="Picker/Margin/Layout/Buttons/Close" to="." method="_on_close_pressed"]
