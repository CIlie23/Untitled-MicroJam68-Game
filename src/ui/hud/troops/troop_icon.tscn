[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/hud/troops/troop_icon.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_back"]
bg_color = Color(0, 0, 0, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_fill"]
bg_color = Color(1, 0, 0.16470589, 1)

[node name="TroopIcon" type="Button"]
custom_minimum_size = Vector2(48, 60)
flat = true
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 2.0
offset_top = 2.0
offset_right = -2.0
offset_bottom = -2.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Icon" type="TextureRect" parent="Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Level" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 12
horizontal_alignment = 1

[node name="Health" type="ProgressBar" parent="Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 5)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("StyleBoxFlat_back")
theme_override_styles/fill = SubResource("StyleBoxFlat_fill")
show_percentage = false

[connection signal="pressed" from="." to="." method="_on_pressed"]
